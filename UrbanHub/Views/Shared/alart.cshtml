
@if(ViewBag.Status != null){
	if (ViewBag.Error == false)
	{
		<div class="alert alert-dismissible alert-success mt-4">
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			<strong>
				<h1 class="display-4 fw-medium"></h1>@ViewBag.MessageTitle</strong>
			<p class="lead fw-normal">@ViewBag.message</p>
		</div>
	}
	else
	{
		<div class="alert alert-dismissible alert-danger mt-4">
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			<strong> <h1 class="display-4 fw-medium">@ViewBag.MessageTitle</h1></strong> <p class="lead fw-normal">@ViewBag.Message</p>
		</div>
	}
}


@if(TempData["Error"] != null && TempData["Message"] != null && TempData["Message"].ToString() != ""){
	if ((bool?)TempData["Error"] == false)
	{
		<div class="alert alert-dismissible alert-success mt-4">
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			<strong>
				<h1 class="display-4 fw-medium"></h1>@(TempData["MessageTitle"] ?? TempData["MesssageTitle"])</strong>
			<p class="lead fw-normal">@TempData["Message"]</p>
		</div>
	}
	else
	{
		<div class="alert alert-dismissible alert-danger mt-4">
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			<strong> <h1 class="display-4 fw-medium">@(TempData["MessageTitle"] ?? TempData["MesssageTitle"])</h1></strong> 
			<p class="lead fw-normal">@TempData["Message"]</p>
		</div>
	}
}

