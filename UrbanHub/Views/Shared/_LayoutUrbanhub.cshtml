<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<title>@ViewData["Title"] - UrbanHub</title>
	<script type="importmap"></script>
	@* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css"/>
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
	<link rel="stylesheet" href="~/css/page/navbar.css" asp-append-version="true"/>
	@* <link rel="stylesheet" href="~/UrbanHub.styles.css" asp-append-version="true" /> *@
	<link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" asp-append-version="true"/>
	<style>
		.nav-link.active {
			border-bottom: 3px solid #0F6DF0 !important;
			color: #0F6DF0 !important;
			font-weight: 600;
		}
	</style>
</head>
<body>
<header>
	@if (ViewData["Title"] != "Login")
	{
		<div style="height: 85px;"></div>
		<nav class="navbar navbar-expand-lg navbar-premium py-3 transition-base position-fixed top-0 start-0 w-100 z-3">
			<div class="container-fluid px-3 px-md-4 px-lg-5">
				<!-- Brand -->
				<a class="navbar-brand d-flex align-items-center gap-3 text-decoration-none brand-wrapper" asp-controller="Home" asp-action="Index">
					<img src="~/assets/img/logo.png" alt="UrbanHub Logo" class="logo logo-hover"/>
					<span class="fw-bold fs-5 text-dark mb-0">UrbanHub</span>
				</a>

				<!-- Mobile Toggle -->
				<button class="navbar-toggler border-0 shadow-none p-2 toggler-icon-custom" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>

				<!-- Nav Items -->
				<div class="collapse navbar-collapse" id="navbarNav">
					<ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-1 gap-lg-3 align-items-center">
						<li class="nav-item">
							<a class="nav-link fw-600 text-dark nav-hover-effect @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" 
							   asp-controller="Home" asp-action="Index">
									Home
								</a>
						</li>
						<li class="nav-item">
							<a class="nav-link fw-600 text-dark nav-hover-effect @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ParkINHome" && ViewContext.RouteData.Values["Action"]?.ToString() == "Browse" ? "active" : "")" 
								asp-controller="ParkINHome" asp-action="Browse">
								ParkIN
								</a>
						</li>
						<li class="nav-item">
							<a class="nav-link fw-600 text-muted nav-hover-effect" 
							   aria-disabled="true">
							
							</a>
						</li>
						@if (User.IsInRole("Admin"))
						{
							<li class="nav-item">
								<a asp-action="Home" asp-controller="Admin" class="nav-link fw-600 text-muted nav-hover-effect"
								   aria-disabled="true">
                                                Admin Panel
								</a>
							</li>
						}
					</ul>

					<!-- Right side tools -->
					<div class="d-flex align-items-center gap-3 ms-lg-4 mt-3 mt-lg-0 ps-lg-3 border-lg-start">
						<!-- Notification Icon -->
						<a href="#" class="text-dark position-relative nav-icon-hover transition-base text-decoration-none icon-wrapper">
							<i class="fa-regular fa-bell fs-5"></i>
							<span class="position-absolute top-1 start-100 translate-middle p-1 bg-danger border border-light rounded-circle notification-badge">
								<span class="visually-hidden">New notifications</span>
							</span>
						</a>

						@if (!User.Identity.IsAuthenticated)
						{
							<!-- Login Button -->
							<a class="btn btn-auth btn-login fw-600 px-4 shadow-sm login-btn-hover transition-base ms-2"
									   asp-action="login_reg" asp-controller="login_regisration">
								<i class="fa-solid fa-arrow-right-to-bracket me-2"></i>Login
							</a>
						}
						else
						{
							<a class="btn btn-auth btn-logout fw-600 px-4 shadow-sm login-btn-hover transition-base ms-2"
									   asp-action="logout" asp-controller="login_regisration"
							   onclick="return confirm('Are you sure you want to Logout!')">
								<i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Logout
							</a>
						}
					</div>
				</div>
			</div>
		</nav>
	}

</header>

<div id="Notification" class="notification" role="status" aria-live="polite">
	<div id="notifType" class="type">System alert</div>
	<div id="notifMessage" class="message">notification message.</div>
</div>

@if ((ViewData["FullWidth"] as bool?) == true)
{
	<main role="main" class="pb-3">
		@RenderBody()
	</main>
}
else
{
	<div class="container">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>
}
@if (ViewData["Title"] != "Login")
{
	<footer class="footer-premium border-top mt-5 pt-5 pb-4">
		<div class="container-fluid px-3 px-md-4 px-lg-5">
			<div class="row align-items-center">
				<div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
					<p class="mb-0 text-muted fw-500">
						<span class="fw-600 text-dark">© 2026 UrbanHub</span> - All rights reserved
					</p>
				</div>
				<div class="col-md-6 text-center text-md-end">
					<a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted footer-link fw-500">Privacy Policy</a>
				</div>
			</div>
		</div>
	</footer>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script type="module" src="~/js/layout.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>

</html>
@section Scripts{
@Html.Partial("_ValidationScriptsPartial")
}