@model List<ParkingBooking>
@{
	ViewBag.Title = "Manage Bookings";
	Layout = "_LayoutParkIN";
}

<partial name="alart" />

<div class="container-fluid py-4 py-lg-5">
	<div class="row mb-5">
		<div class="col-12">
			<h1 class="fw-bold text-dark mb-1">My Parking Bookings</h1>
			<p class="text-muted mb-0">View and manage all your parking reservations</p>
		</div>
	</div>

	<button class="btn btn-secondary m-2" id="RecivePayment"
			style="width:fit-content; margin-left:auto; margin-right:0px;">
		<i class="fa-solid fa-money-bill-transfer"></i>
		Receive Payment
	</button>

	<form method="post">
		<div id="payment" class="d-none col-6 shadow m-2 p-4 rounded d-flex flex-column gap-2 align-content-center
			justify-content-center" style="transition: all 1.5s ease;">

			<label>Choose Your Booking For Payment</label>
			<select name="ID" class="form-control" id="select">
				<option value="" disabled selected>Select a booking </option>
				@foreach (var item in Model)
				{
					if (item.Parking.IsAvailable && item.PaymentStatus.ToLower() == "paid" && !item.Withdrawn)
					{
						<option value="@item.ID">@item.Parking.Address</option>
					}
				}
			</select>
			<label>Enter the OTP From the Renter</label>
			<input id="OTP" name="OTP" type="text" class="form-control" placeholder="Enter OTP" />
			<button type="submit" id="formsubmit" asp-controller="ParkINManageBookings" asp-action="RequestPayment"
					class="col-3 btn btn-primary" style="width:fit-content;">
				<i class="fa-solid fa-money-bill-transfer"></i>
				Request Payment
			</button>
		</div>
	</form>

	@if (Model.Count > 0)
	{
		<div class="card border-0 shadow-sm" style="max-height:95vh">
			<div class="card-body p-0">
				<div class="table-responsive">
					<table class="table table-hover mb-0">
						<thead class="table-light">
							<tr>
								<th class="text-center">Name</th>
								<th class="text-center">Contact details</th>
								<th class="text-center">Status</th>
								<th class="text-center">Vehicle Type</th>
								<th class="text-center">Duration</th>
								<th class="text-center">Payment Amount</th>
								<th class="text-center">Payment Status</th>
								<th class="text-center">Withdrawn Status</th>
								<th class="text-center">Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var booking in Model)
							{
								<tr class="align-middle">
									<td class="fw-500 text-info">@booking.Renter.Name.ToUpper()</td>
									<td class="text-center"> <a href="mailto:@booking.Renter.Email">@booking.Renter.Email</a>
										<br />
										<a href="tel:@booking.Renter.Phone">@booking.Renter.Phone</a>
									</td>
									<td class="text-center">
										@{
											string statusClass = booking.Status == "Active" ? "bg-success" :
												booking.Status == "Completed" ? "bg-secondary" :
												booking.Status == "Cancelled" ? "bg-danger" : "bg-warning";
										}
										<span class="badge @statusClass">@booking.Status</span>
									</td>
									<td class="text-center">
										<span class="badge bg-info">@booking.Parking.VehicleType</span>
									</td>
									<td class="text-center small">
										<div>@booking.StartingTime.ToString("dd MMM, HH:mm")</div>
										<div class="text-muted">→</div>
										<div>@booking.EndingTime.ToString("dd MMM, HH:mm")</div>
									</td>
									<td class="text-center fw-bold text-info">@booking.PaymentAmount BDT </td>
									<td class="text-center">
										@{
											string paymentClass = booking.PaymentStatus == "Completed" ? "bg-success" :
												booking.PaymentStatus == "Pending" ? "bg-warning" :
												booking.PaymentStatus == "Failed" ? "bg-danger" : "bg-secondary";
										}
										<span class="badge @paymentClass">@booking.PaymentStatus</span>
									</td>
									<td class="text-center">
										@{
                                            string withdrawnClass = booking.Withdrawn ? "bg-success" : "bg-danger";
										}
										<span class="badge @withdrawnClass">@(booking.Withdrawn ? "Yes" : "No")</span>
									</td>
									<td class="text-center">
										<div class="d-flex gap-2  flex-wrap">
											@if (!booking.Parking.IsAvailable)
											{
												<span class="text-danger">Parking Space Not Available</span>
											}
											else if (booking.Status.ToLower() == "pending")
											{
												<a onclick="return confirm('Are you sure you want to cancel this booking?');"
												   asp-action="Accept" asp-route-id="@booking.ID"
												   asp-controller="ParkINManageBookings" class="btn btn-success">
													<i class="fa-solid fa-check"></i> Accept
												</a>
												<a onclick="return confirm('Are you sure you want to cancel this booking?');"
												   asp-action="Cancel" asp-route-id="@booking.ID"
												   asp-controller="ParkINManageBookings" class="btn  btn-outline-danger">
													<i class="fas fa-times"></i> Cancel
												</a>
											}
											else if (booking.Status.ToLower() == "accepted" && !booking.Withdrawn)
											{
												<a onclick="return confirm('Are you sure you want to cancel this booking?');"
												   asp-action="Cancel" asp-route-id="@booking.ID" asp-controller="ParkINBookings"
												   class="btn  btn-outline-danger">
													<i class="fas fa-times"></i> Cancel
												</a>
											}
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
	else
	{
		<div class="alert alert-info text-center py-5" role="alert">
			<i class="fas fa-inbox fa-3x mb-3 d-block"></i>
			<h5 class="mb-2">No Bookings Yet</h5>
			<p class="mb-0">You haven't made any parking bookings. Start exploring available parking spaces now!</p>
		</div>
	}
</div>
<script>
	let receivePaymentBtn = document.getElementById('RecivePayment');
	let paymentSection = document.getElementById('payment');
	let formsubmit = document.getElementById('formsubmit');
	let otp = document.getElementById("OTP").value;
	let select = document.getElementById("select").value;
	if (receivePaymentBtn) {
		receivePaymentBtn.addEventListener('click', function (e) {

			if (paymentSection.classList.contains('d-none')) {
				paymentSection.classList.remove('d-none');
			} else {
				paymentSection.classList.add('d-none');
			}
		});
	}

	if (formsubmit) {
		formsubmit.addEventListener('click', function (e) {
			let otpElement = document.getElementById("OTP");
			let selectElement = document.getElementById("select");
			let otpValue = otpElement.value;
			let selectValue = selectElement.value;

			otpElement.style.border = "";
			selectElement.style.border = "";

			let isValid = true;
			if (otpValue == "") {
				otpElement.style.border = "1px solid red";
				isValid = false;
			}
			if (selectValue == "") {
				selectElement.style.border = "1px solid red";
				isValid = false;
			}

			if (!isValid) {
				e.preventDefault();
			}
		});
	}

</script>