@model List<Log>
@{
    ViewBag.Title = "User Management";
    Layout = "adminlayout";
}

<partial name="alart" />

<!-- Stats Section -->
@if (Model != null && Model.Count > 0)
{
    <div class=" col-2  mb-4 ">
        <div class="col-md-12">
            <div class="card border-1 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h6 class="text-muted mb-1">Total Logs Loaded</h6>
                            <h3 class="text-primary font-weight-bold mb-0">@Model.Count</h3>
                        </div>
                        <div style="font-size: 2.5rem; color: #007bff; opacity: 0.3;">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* <div>
    <form method="get">
        <div class="d-flex flex-column gap-2 m-2 border-1">
            <label>Search Users</label>
            <input name="searchTerm" type="text" id="searchInput" class="form-group col-3" placeholder="Enter user name or email...">
            <button class="btn btn-primary col-1" id="searchBtn" asp-controller="AdminUserManagement" asp-action="Users">Search</button>
        </div>
    </form> *@
    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info text-center" role="alert">
            <h5 class="mb-2"><i class="fas fa-inbox"></i> No Logs Found</h5>
            <p class="mb-0">There are currently no logs in the system.</p>
        </div>
    }
    else
    {
    <div class="shadow p-3 mt-3 rounded-3" style="max-height: 600px; overflow-Y: auto; ">
    <table class="table table-hover " >
            <thead style="position:sticky;  width:100%; top:0;">
        <tr>
            <th scope="col">Name</th>
            <th scope="col">Contact</th>
            <th scope="col">Log Message</th>
            <th scope="col">Updated At Date</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var i in Model)
        {
            <tr>
                <td>@i.User?.Name</td>
                <td> <a href="mailto:@i.User?.Email">@i.User?.Email</a> - <a href="tel:@i.User?.Phone">@i.User?.Phone</a></td>
                <td>@i.Message</td>
                <td>@i.UpdatedAt</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    }

<script src="~/js/adminUsers.js"></script>