@model List<ParkingSpace>
@{
	ViewBag.Title = "My spaces";
	Layout = "_LayoutParkIN";
}

<partial name="alart" />

<div class="container-fluid py-4 py-lg-5">
	<div class="row mb-5">
		<div class="col-12">
			<h1 class="fw-bold text-dark mb-1">My Parking spaces</h1>
			<p class="text-muted mb-0">View and manage all your parking reservations</p>
		</div>
	</div>

	<a asp-action="Create" asp-controller="ParkingSpace" class="btn btn-primary m-2"
	   style="width:fit-content; margin-left:auto; margin-right:0px;">
		<i class="fa-solid fa-circle-plus"></i>
		NEW Space
	</a>

	@if (Model != null && Model.Count > 0)
	{
		<div class="card border-0 shadow-sm">
			<div class="card-body p-0">
				<div class="table-responsive " style="max-height: 95vh; scrollbar-width:none ; overflow-y: auto;">


					<table class="table table-hover mb-0">
						<thead class="table-light" style="position: sticky; top: 0; z-index: 10;">
							<tr>
								<th class="text-center">Address</th>
								<th class="text-center">Rent/Hour</th>
								<th class="text-center">Available</th>
								<th class="text-center">Vehicle Type</th>
								<th class="text-center">Description</th>
								<th class="text-center">Listed At</th>
								<th class="text-center">Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var space in Model)
							{
								<tr class="align-middle">
									<td class="fw-500 text-info" style="max-width:200px;">@space.Address</td>
									<td class="text-center">৳@space.RentPerHour</td>
									<td class="text-center">
										@if (space.IsAvailable)
										{
											<span class="badge bg-success">Available</span>
										}
										else
										{
											<span class="badge bg-warning">Not Available</span>
										}
									</td>
									<td class="text-center">
										<span class="badge bg-info">@space.VehicleType</span>
									</td>
									<td class="" style="max-width:300px">@space.Description</td>
									<td class="text-center">@space.Date.ToString("yyyy-MM-dd")</td>
									<td class="text-center">
										<a class="btn btn-info" asp-action="Edit" asp-controller="ParkingSpace"
										   asp-route-id="@space.ID">
											<i class="fa-solid fa-pen-to-square"></i>Edit
										</a>
										<a class="btn btn-danger" asp-action="Delete" asp-controller="ParkINMySpace"
										   asp-route-id="@space.ID"
										   onclick="return confirm('Are you sure you want to delete this parking space?');">
											<i class="fa-solid fa-trash-can"></i>Delete
										</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
	else
	{
		<div class="alert alert-info text-center py-5" role="alert">
			<i class="fas fa-inbox fa-3x"></i>
			<h5 class="mb-2"> Not Listed Spots Yet!!</h5>
			<a class="text-danger text-decoration-none" asp-action="Create" asp-controller="ParkingSpace">
				Share your parking spots with others and start earning!
			</a>
		</div>
	}
</div>
