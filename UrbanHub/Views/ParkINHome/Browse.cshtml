@using System.Collections
@model ParkInBrowseModel
@{
	ViewBag.Title = "ParkIN";
	Layout = "_LayoutParkIN";
	ViewData["FullWidth"] = true;
}

<section class="d-flex align-items-center" style="width: 100%; min-height: calc(100vh - 88px);
	margin-top: -70px; background-image: url('/assets/img/UrbanHubHero.png');
	background-size: cover; background-position: center; background-repeat: no-repeat;">

	<div style="margin-left:5%; max-width: 40rem; color: black; padding: 4rem 1.5rem; margin-top: -105px;">
		<h2 style="font-size: clamp(3rem, 6vw, 6.25rem); line-height: 0.95; color:black;">
			Park smart.
			<br />Live <span class="text-primary">easy.</span>
		</h2>

		<p style="font-size: clamp(1.1rem, 2vw, 1.5rem); max-width: 32rem;">
			Find, book, and manage parking spots effortlessly across the city.
		</p>

		<div class="d-flex gap-4 ">
			<a asp-controller="ParkingSpace" asp-action="Create" class=" btn btn-primary  rounded-4 px-4 py-2 mt-3"
			   style="font-size: 1.1rem;">
				<i class="fa-solid fa-location-dot"></i> &nbsp; Share Your Space
			</a>
			<a class="btn btn-light rounded-4 px-4 py-2 mt-3" style="font-size: 1.1rem;">
				<i class="fa-solid fa-compass"></i> &nbsp; Explore ParkIN
			</a>
			<br />
		</div>
	</div>
</section>
<form method="post" asp-action="Search" asp-controller="ParkINHome">
	<section class="container py-4 px-3 px-lg-4 bg-white rounded-4 shadow-sm border position-relative"
			 style="margin-top: -6.5rem;">
		<div class="row g-3 align-items-end">

			<div class="col-12 col-lg-3">
				<label class="form-label fw-semibold text-secondary">Enter your location</label>
				<input asp-for="SearchSpaces.SearchText" type="text" class="form-control form-control-lg"
					   placeholder="City, Address, Area" />
			</div>

			<div class="col-12 col-lg-3">
				<label class="form-label fw-semibold text-secondary">Select Vehicle Type</label>
				<select asp-for="SearchSpaces.Type" class="form-select form-select-lg">
					<option value="" selected disabled hidden>Select an option</option>
					<option value="Car">Car</option>
					<option value="Motorcycle">Motorcycle</option>
					<option value="Bicycle">Bicycle</option>
				</select>
			</div>

			<div class="col-12 col-lg-3">
				<label class="form-label fw-semibold text-secondary">Select Time Slot <span
					class="text-muted">(Optional)</span></label>
					<input asp-for="SearchSpaces.DateAndTime" type="datetime-local" class="form-control form-control-lg"
						   value="" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
				</div>

				<div class="col-12 col-lg-3 d-flex align-items-end">
					<button class="btn btn-primary rounded-pill px-4 py-3 fw-semibold w-100 shadow-sm">
						<i class="fa-solid fa-magnifying-glass-location"></i> &nbsp;Search
					</button>
				</div>

				<div class="col-12 mt-2">
					<div
						class="alert alert-primary d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 rounded-4 mb-0">
						<div>
							<div class="fw-bold mb-1">Nearby parking</div>
							<div>See the best nearby spaces first, with a cleaner discovery flow for this new feature.</div>
						</div>
						<a onclick="NearBy()" class="btn btn-light text-primary fw-semibold rounded-pill px-4 py-3">
							<i class="fa-solid fa-location-dot"></i> &nbsp; Explore nearby parking spots
						</a>
					</div>
				</div>
			</div>
		</section>
	</form>
	<section class="container py-4 px-3 px-lg-4">
		<div class="d-flex align-items-center justify-content-between mb-3">
			<p class="fw-bold fs-5 mb-0">
				<i class="fa-solid fa-magnifying-glass-location text-primary"></i>
				Available parking spaces <span class="text-success">@Model.TotalResults</span>
			</p>
			<a class="" asp-action="LiveMap" asp-controller="ParkINHome">Map</a>
		</div>

		<div class="row row-cols-1 row-cols-md-3 g-4">

			@foreach (var i in Model.ParkingSpaces ?? new List<ParkingSpaceDTO>())
			{
				<form method="post">
					<div class="col">
						<div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
							<img class="card-img-top"
								 src='@(string.IsNullOrEmpty(i.Image) ? "/assets/img/Broken.png" : i.Image)'
								 alt="Parking spot image" style="aspect-ratio: 16 / 10; object-fit: cover;">
							<div class="card-body p-3">
								<div class="d-flex justify-content-between align-items-start mb-2">
									<div>
										<h5 class="card-title mb-1 fw-semibold">@i.Address</h5>
										<p class="text-muted small mb-0">Rent/Hour @i.RentPerHour BDT</p>
									</div>
									<span class="badge text-bg-success rounded-pill">@(i.Distance == 0 ? "open" : i.Distance +
																		"Km Straight")</span>
									</div>
									<p class="card-text text-secondary">@i.Description</p>
									<a class="btn btn-outline-primary rounded-pill px-3" asp-controller="ParkINDetails"
									   asp-action="ViewDetails" asp-route-image="@i.Image" asp-route-id="@i.ID">
										<i class="fa-solid fa-circle-info"></i>&nbsp;View details
									</a> &nbsp;

							
									<a href='@(i.Location == null ? "#" : $"https://www.google.com/maps/dir/?api=1&destination={i.Location.Y},{i.Location.X}&travelmode=driving")'
									   target="_blank" class="btn btn-outline-primary rounded-pill ml-3 px-3">
										<i class="fa-solid fa-map"></i>&nbsp;View On Map
									</a>
								</div>
							</div>
						</div>
					</form>
				}

		
			</div>
		</section>

		<div class="d-flex justify-content-center">
			@* pagination *@
			<nav aria-label="Page navigation example">
				<ul class="pagination">
					<li class="page-item">
						<a asp-action="Browse" asp-route-page="@(Model.CurrentPage-1)" class="page-link @if(Model.CurrentPage <= 1){
							<text>disabled</text>
						}
						"  aria-label="Previous">
						<span aria-hidden="true">&laquo;</span>
						<span class="sr-only">Previous</span>
					</a>
				</li>
				@if (Model.CurrentPage > 2)
				{
			<li class="page-item">
				<a class="page-link" asp-action="Browse" asp-route-page="1"
												 asp-controller="ParkINHome">1</a></li>
					}
		<li class="page-item">
			<a class="page-link text-bg-primary" asp-action="Browse" asp-route-page="@Model.CurrentPage"
												 asp-controller="ParkINHome">@(Model.CurrentPage)</a>
					</li>
					<li class="page-item">
			<a class="page-link" asp-action="Browse" asp-route-page="@(Model.CurrentPage + 1)"
						   asp-controller="ParkINHome" aria-label="Next">
							<span aria-hidden="true">&raquo;</span>
							<span class="sr-only @if (Model.CurrentPage >= (Model.TotalResults/21 )) { <text>disabled</text> }">
								Next
							</span>
						</a>
					</li>
				</ul>
			</nav>
		</div>

		<script>

	
			function NearBy() {
				navigator.geolocation.getCurrentPosition(function (position) {
					var lat = position.coords.latitude;
					var lng = position.coords.longitude;
					sessionStorage.setItem("lat", lat);
					sessionStorage.setItem("lng", lng);
					window.location.href = '@Url.Action("BrowseNearby",
						                        "ParkINHome")' + '?lat=' + lat + '&lng=' + lng;

				});

		
			}

		</script>

		@section Scripts {
			@Html.Partial("_ValidationScriptsPartial")
		}