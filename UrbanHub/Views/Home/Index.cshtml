@{
    ViewBag.title = "Home Page";
	Layout = "_LayoutUrbanHub";
}
<link href="~/css/page/home.css" rel="stylesheet" />

<div class="alert alert-dismissible alert-success" style="top:-30px;">
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    <strong> <h1 class="display-4 fw-medium">Welcome to UrbanHub</h1></strong> <p class="lead fw-normal">Your one-stop destination for all things urban living.</p>

<!-- HR & Technical Overview Accordion / Dropdown Section -->
<div class="my-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 p-3 p-md-4 d-flex justify-content-between align-items-center cursor-pointer" 
             style="background: linear-gradient(135deg, #f8f9fa 0%, #eef2f7 100%); cursor: pointer;" 
             data-bs-toggle="collapse" data-bs-target="#projectInfoCollapse" aria-expanded="true" aria-controls="projectInfoCollapse">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-2 bg-primary bg-opacity-10 text-primary fs-4 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark mb-0">Project Purpose & Architecture Summary</h5>
                    <small class="text-muted">Click to view project details, module vision, and stack specs</small>
                </div>
            </div>
            <button class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-none fw-semibold" type="button">
                <i class="fa-solid fa-chevron-down me-1"></i> Overview
            </button>
        </div>
        <div class="collapse show" id="projectInfoCollapse">
            <div class="card-body p-4 bg-white border-top">
                <div class="row g-4">
                    <!-- Project Purpose -->
                    <div class="col-lg-6 border-end-lg">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-2 py-1"><i class="fa-solid fa-bullseye me-1"></i> Project Purpose & Vision</span>
                        </div>
                        <h6 class="fw-bold text-dark mb-2">UrbanHub Ecosystem</h6>
                        <p class="text-secondary small leading-relaxed mb-3">
                            UrbanHub is an all-in-one smart city management ecosystem designed to simplify urban living by unifying multiple services into a single platform.
                        </p>
                        <div class="d-flex flex-column gap-2 small">
                            <div class="d-flex align-items-start gap-2">
                                <i class="fa-solid fa-circle-check text-success mt-1"></i>
                                <span><strong>ParkIN Module:</strong> Real-time parking space finder, slot booking, live map tracking, host space management, and integrated digital wallet.</span>
                            </div>
                            <div class="d-flex align-items-start gap-2">
                                <i class="fa-solid fa-clock text-primary mt-1"></i>
                                <span><strong>Future Hubs:</strong> Designed ready to integrate <strong>FoodHub</strong> (food delivery) and <strong>StayHub</strong> (short-term rentals).</span>
                            </div>
                            <div class="d-flex align-items-start gap-2">
                                <i class="fa-solid fa-user-gear text-info mt-1"></i>
                                <span><strong>Role Access Control:</strong> Seamless experience for Customers, Parking Space Owners, and System Administrators.</span>
                            </div>
                        </div>
                    </div>

                    <!-- Architecture Overview -->
                    <div class="col-lg-6">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1"><i class="fa-solid fa-diagram-project me-1"></i> Technical Architecture</span>
                        </div>
                        <h6 class="fw-bold text-dark mb-2">System Stack & Design Pattern</h6>
                        <ul class="list-unstyled small text-secondary mb-0 d-flex flex-column gap-2">
                            <li class="d-flex align-items-center gap-2">
                                <span class="badge bg-dark rounded-pill px-2" style="min-width:75px;">Frontend</span>
                                <span>ASP.NET Core 8 MVC, Razor Views, Bootstrap 5, FontAwesome & Custom JS</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <span class="badge bg-dark rounded-pill px-2" style="min-width:75px;">Backend</span>
                                <span>N-Tier Architecture (Controllers, Repository Pattern, DTO Data Contracts)</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <span class="badge bg-dark rounded-pill px-2" style="min-width:75px;">Database</span>
                                <span>Entity Framework Core with SQL Server & Code-First Migrations</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <span class="badge bg-dark rounded-pill px-2" style="min-width:75px;">Security</span>
                                <span>Claims-Based Cookie Auth (`UrbanAuth`), Password Hashing & Role Authorization</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class=" mt-4 d-flex flex-wrap">
    <div class="primarybg shadow rounded-4 d-flex flex-column p-4 text-white cardshover flex-grow-1" style="max-width:700px">
        <span class="rounded-4 p-2 label">
           NEW UPDATE
       </span>
       <p class="fs-1 pt-1">
            Parking Just Got Smarter
       </p>
        <p class="fs-5">Find, book, and manage parking spaces instantly in your area.</p>
        <a asp-action="Browse" asp-controller="ParkINHome" class="rounded-4 p-2 cardbtn text-decoration-none">
            Explore Now
        </a>
    </div>
    <div> </div>
</div>


    <div class="py-4 fs-2 fw-medium"> City Ecosystem</div>
    <div class="d-flex flex-wrap gap-4">
        
        @* parkin *@

        <div class="d-flex flex-column flex-grow-0 shadow rounded-4 p-3 service_card" >
                <i class="fa-solid fa-square-parking  "></i>
                <p class="fs-5">ParkIN</p>
        <p class="fs-6">
            Find available parking spaces in real time around you.
            Book instantly and park without the hassle
        </p>
        <a asp-action="Browse" asp-controller="ParkINHome" class="cardlink primarycolor text-decoration-none">Find space <i class="fa-solid fa-arrow-right align-text-bottom "></i></a>
        </div>

        <div class="d-flex flex-column flex-grow-0 shadow rounded-4 p-3 service_card disable">
            <i class="fa-solid fa-square-parking  "></i>
            <p class="fs-5">FoodHub</p>
            <p class="fs-6">
            Order your favorite meals from nearby restaurants.
            Fast delivery right to your doorstep, anytime
            </p>
        <p class="cardlink primarycolor">Coming soon <i class="fa-solid fa-arrow-right align-text-bottom"></i></p>

        </div>

        <div class="d-flex flex-column flex-grow-0 shadow rounded-4 p-3 service_card disable">
            <i class="fa-solid fa-square-parking  "></i>
        <p class="fs-5">StayHub</p>
            <p class="fs-6">
            Discover verified local
            homes, short-term
            rentals, and flexible living
            spaces.
            </p>
        <p class="cardlink primarycolor">Coming soon <i class="fa-solid fa-arrow-right align-text-bottom"></i></p>

        </div>
    </div>
