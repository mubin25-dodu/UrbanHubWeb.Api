@model List<Withdrawal>
@{
    ViewBag.Title = "User Management";
    Layout = "adminlayout";
}

<partial name="alart" />

<!-- Stats Section -->
@if (Model != null && Model.Count > 0)
{
    <div class=" col-2  mb-4">
        <div class="col-md-12">
            <div class="card border-1 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h6 class="text-muted mb-1">Total Transactions Loaded</h6>
                            <h3 class="text-primary font-weight-bold mb-0">@Model.Count</h3>
                        </div>
                        <div style="font-size: 2.5rem; color: #007bff; opacity: 0.3;">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div>
    <form method="get">
        <div class="d-flex flex-column gap-2 m-2 border-1">
            <label>Search Transactions</label>
            <input name="searchTerm" type="text" id="searchInput" class="form-group col-3" placeholder="Enter transaction details...">
            <button class="btn btn-primary col-1" id="searchBtn" asp-controller="AdminTransactions" asp-action="Transactions">Search</button>
        </div>
    </form>
    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info text-center" role="alert">
            <h5 class="mb-2"><i class="fas fa-inbox"></i> No Users Found</h5>
            <p class="mb-0">There are currently no users in the system.</p>
        </div>
    }
    
    <div class="shadow p-3 mt-3 rounded-3">
        <h2 class="mb-3">Pending Transactions:</h2>
        <table class="table table-hover">
            <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Contact</th>
                <th scope="col">Method</th>
                <th scope="col">AccountInfo</th>
                <th scope="col">Amount</th>
                <th scope="col">Date</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var i in Model)
            {
                if (i.Status.ToLower() == "pending")
                {
                    <tr style="@(i.Status?.ToLower() == "banned" ? "background-color: #fff3cd; border-left: 4px solid #ffc107;" : "")">
                        <td>@i.User.Name</td>
                        <td> <a href="mailto:@i.User.Email">@i.User.Email</a> - <a href="tel:@i.User.Phone">@i.User.Phone</a></td>
                        <td>@i.Method</td>
                        <td>@i.AccountInfo</td>
                        <td>@i.Amount BDT</td>
                        <td>@i.Date</td>
                        <td class="text-danger">@i.Status</td>
                        <td>
                            <a asp-action="Task" asp-route-id="@i.ID" asp-route-task="Approved" class="btn btn-sm btn-success">
                                <i class="fa-solid fa-check"></i> Accept
                            </a>

                            <a asp-action="Task" asp-route-id="@i.ID" asp-route-task="Decline" class="btn btn-sm btn-danger">
                                <i class="fa-solid fa-xmark"></i> Decline
                            </a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <div class="shadow p-3 mt-3 rounded-3">
    <h2 class="mb-3">Processed Transactions:</h2>
    <table class="table table-hover">
        <thead>
        <tr>
            <th scope="col">Name</th>
            <th scope="col">Contact</th>
            <th scope="col">Method</th>
            <th scope="col">AccountInfo</th>
            <th scope="col">Amount</th>
            <th scope="col">Date</th>
            <th scope="col">Status</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var i in Model)
        {
            if (i.Status.ToLower() != "pending")
            {
                <tr style="@(i.Status?.ToLower() == "banned" ? "background-color: #fff3cd; border-left: 4px solid #ffc107;" : "")">
                    <td>@i.User.Name</td>
                    <td> <a href="mailto:@i.User.Email">@i.User.Email</a> - <a href="tel:@i.User.Phone">@i.User.Phone</a></td>
                    <td>@i.Method</td>
                    <td>@i.AccountInfo</td>
                    <td>@i.Amount BDT</td>
                    <td>@i.Date</td>
                    <td class="text-danger">@i.Status</td>
                </tr>
            }
        }
        </tbody>
    </table>
    </div>

</div>

<script src="~/js/adminUsers.js"></script>